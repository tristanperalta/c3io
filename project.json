{
  "langrev": "1",
  "authors": [
    "Tristan Peralta <tristan@peralta.ph>",
    "Claude Code <noreply@anthropic.com>"
  ],
  "version": "0.3.0",
  "warnings": [
    "no-unused"
  ],
  "dependency-search-paths": [
    "."
  ],
  "dependencies": [
    "c3io"
  ],
  "output": ".",
  "targets": {
    "c3io-tests": {
      "type": "test",
      "sources": [
        "test/**"
      ]
    },
    "c3io": {
      "type": "static-lib",
      "sources": [
        "c3io.c3l/**"
      ],
      "dependencies-override": [],
      "linked-libraries": [
        "uv"
      ]
    },
    "timer-example": {
      "type": "executable",
      "sources": [
        "examples/timer_example.c3"
      ]
    },
    "http-server": {
      "type": "executable",
      "sources": [
        "examples/http_server.c3"
      ]
    }
  },
  "link-libc": true
}
